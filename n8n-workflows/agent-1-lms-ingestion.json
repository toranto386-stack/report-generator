    {
      "parameters": {
        "jsCode": "const event = $json;\nconst kind = event.kind;\nconst base = event.backendBaseUrl || 'http://host.docker.internal:4001';\nconst map = {\n  attendance: '/ingest/attendance',\n  assignment_score: '/ingest/assignment-score',\n  doubt: '/ingest/doubt',\n  project_milestone: '/ingest/project-milestone'\n};\nif (!map[kind]) throw new Error(`Unsupported LMS event kind: ${kind}`);\nreturn [{ json: { url: `${base}${map[kind]}`, payload: event.payload } }];"
      },
      "id": "NormalizeEvent",
      "name": "Normalize LMS Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
