generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DoubtStatus {
  OPEN
  RESOLVED_BY_MENTOR
  RESOLVED_INDEPENDENTLY
}

enum ReportDeliveryStatus {
  DRAFT
  SENT
  FAILED
}

enum UserRole {
  ADMIN
  COACH
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  passwordHash String
  role         UserRole @default(COACH)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Student {
  id             String             @id @default(cuid())
  fullName       String
  email          String             @unique
  whatsappNumber String?
  weekNumber     Int                @default(1)
  parent         Parent?
  attendances    Attendance[]
  assignments    AssignmentScore[]
  doubts         Doubt[]
  milestones     ProjectMilestone[]
  weeklyReports  WeeklyReport[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model Parent {
  id             String   @id @default(cuid())
  fullName       String
  email          String?
  whatsappNumber String?
  receiveReports Boolean  @default(true)
  studentId      String   @unique
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Attendance {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sessionAt DateTime
  present   Boolean
  minutes   Int      @default(0)
  topic     String
  createdAt DateTime @default(now())

  @@index([studentId, sessionAt])
}

model AssignmentScore {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title       String
  topic       String
  score       Float
  maxScore    Float
  submittedAt DateTime
  createdAt   DateTime @default(now())

  @@index([studentId, submittedAt])
}

model Doubt {
  id         String      @id @default(cuid())
  studentId  String
  student    Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  question   String
  topic      String
  status     DoubtStatus
  openedAt   DateTime
  resolvedAt DateTime?
  createdAt  DateTime    @default(now())

  @@index([studentId, openedAt])
}

model ProjectMilestone {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title       String
  description String
  progress    Int
  dueDate     DateTime
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([studentId, dueDate])
}

model WeeklyReport {
  id                  String               @id @default(cuid())
  studentId           String
  student             Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  weekStart           DateTime
  weekEnd             DateTime
  weekNumber          Int
  score               Int
  learnedSummary      String
  focusActions        String[]
  encouragement       String
  trajectory          String
  masteredTopics      String[]
  needsWorkTopics     String[]
  deliveryStatus      ReportDeliveryStatus @default(DRAFT)
  studentMessageSid   String?
  parentMessageSid    String?
  deliveryError       String?
  generatedAt         DateTime             @default(now())
  sentAt              DateTime?

  @@unique([studentId, weekStart, weekEnd])
  @@index([weekStart, weekEnd])
}
